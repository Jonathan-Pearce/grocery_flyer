# Environment variables required by the FlyerDeals API
# Copy to .env and fill in real values — never commit .env to version control

# Neon PostgreSQL connection string (async driver)
# Format: postgresql+asyncpg://user:password@host/dbname?sslmode=require
# Obtain from: https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-2.aws.neon.tech/flyerdeals?sslmode=require

# Groq API key for LLM recipe suggestions (Phase 2)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Resend API key for transactional email (Phase 3)
# Obtain from: https://resend.com/api-keys
RESEND_API_KEY=re_...

# MotherDuck token for deal data queries (Phase 1.5)
# Obtain from: https://app.motherduck.com → Settings → Tokens
MOTHERDUCK_TOKEN=...

# Allowed CORS origin — your GitHub Pages URL
# Change if using a custom domain
ALLOWED_ORIGIN=https://jonathan-pearce.github.io
